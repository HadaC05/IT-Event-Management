Options -Indexes -ExecCGI

# Uploaded media must always be served as inert content. Even if an executable
# file bypasses an application-level MIME check, Apache must never run it.
<FilesMatch "\.(?:php[0-9]?|phtml|phar|cgi|pl|py|sh|shtml)$">
    Require all denied
</FilesMatch>

<IfModule mod_mime.c>
    RemoveHandler .php .php3 .php4 .php5 .php7 .php8 .phtml .phar .cgi .pl .py .sh .shtml
    RemoveType .php .php3 .php4 .php5 .php7 .php8 .phtml .phar .cgi .pl .py .sh .shtml
</IfModule>
