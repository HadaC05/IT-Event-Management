DirectoryIndex pages/home.html
Options -Indexes

RewriteEngine On
RewriteRule ^pages/student/?$ /ITEventManagement/pages/student/home.html [R=302,L]
# Mobile camera and geolocation require a trusted HTTPS origin. Keep ordinary
# localhost development working while redirecting non-localhost SBO scanning.
# Cloudflare terminates HTTPS before forwarding the request to Apache over HTTP,
# so honor its forwarded scheme headers to avoid redirecting the public HTTPS URL
# back to itself indefinitely.
RewriteCond %{HTTPS} !^on$ [NC]
RewriteCond %{HTTP:X-Forwarded-Proto} !^https$ [NC]
RewriteCond %{HTTP:CF-Visitor} !(^|.*["']scheme["']\s*:\s*["']https["'].*$) [NC]
RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1)(:[0-9]+)?$ [NC]
RewriteRule ^pages/sbo/attendance\.html$ https://%{HTTP_HOST}%{REQUEST_URI} [R=302,L]
RewriteRule ^api/login\.php$ api/auth.php?action=login [L,QSA]
RewriteRule ^api/logout\.php$ api/auth.php?action=logout [L,QSA]
RewriteRule ^api/session\.php$ api/auth.php?action=session [L,QSA]

# During local development, always revalidate frontend files so HTML and JavaScript
# cannot drift into different cached versions after a pull or UI update.
<IfModule mod_headers.c>
    Header unset X-Powered-By
    Header always unset X-Powered-By
    # Remove inherited or PHP-added CSP headers before applying the app policy.
    # Multiple CSP headers are enforced together, so an inherited script-src
    # 'none' would block local scripts even when this policy allows 'self'.
    Header unset Content-Security-Policy
    Header always unset Content-Security-Policy
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; worker-src 'self' blob:; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://tile.openstreetmap.org; media-src 'self' blob:; connect-src 'self'; font-src 'self' data:; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'"
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "DENY"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(self), geolocation=(self), microphone=()"
    <FilesMatch "\.(?:html|css|js)$">
        Header set Cache-Control "no-cache, must-revalidate"
        Header set Pragma "no-cache"
        Header set Expires "0"
    </FilesMatch>
</IfModule>

<IfModule php_module>
    php_flag expose_php Off
    # Allow the API to detect and reject a selection over 30 photos.
    php_value max_file_uploads 31
    php_value upload_max_filesize 25M
    php_value post_max_size 28M
</IfModule>
